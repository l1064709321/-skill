{
  "name": "tianyan",
  "version": "0.0.1",
  "type": "module",
  "description": "多Agent协同长篇小说创作系统 — 7 Agent · 36工具 · 111位作家语料库",
  "scripts": {
    "postinstall": "node -e \"try{require('child_process').execSync('python3 --version',{stdio:'ignore'})}catch{console.warn('⚠  未检测到 Python 3，技能桥接将使用降级模式（无审计/拆书/AI味检测）。安装 Python 3 后重新运行即可。')}\"",
    "prestart": "npx tsc --noEmit 2>/dev/null || npx tsc",
    "start": "node bin/tianyan.js",
    "dev": "npx tsc --noEmit 2>/dev/null || npx tsc && node bin/tianyan.js",
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.0",
    "better-sqlite3": "^11.0.0",
    "hono": "^4.0.0",
    "playwright": "^1.63.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "src/",
    "web/",
    "app/",
    "app/data/",
    "scripts/",
    "README.md",
    "LICENSE",
    "tsconfig.json",
    "bin/"
  ],
  "bin": {
    "tianyan": "bin/tianyan.js"
  }
}
