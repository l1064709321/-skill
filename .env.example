# ============================================================
# 天衍 - 环境变量配置模板 (TypeScript 版)
# ============================================================
# 使用方法:
#   Linux/macOS:  export TIANYAN_API_KEY=xxx
#   Windows:      set TIANYAN_API_KEY=xxx
#   或在启动时:   TIANYAN_API_KEY=xxx node dist/index.js
# ============================================================

# ========== 认证 ==========
# 所有 /api/* 请求都需要 Bearer token (除健康检查外)
TIANYAN_API_KEY=test123

# ========== 服务端口 ==========
# 默认 8090 (可通过 config.yaml 的 server_port 覆盖)
# TIANYAN_PORT=8090

# ========== CORS 允许的跨域来源 (逗号分隔) ==========
# 默认只允许 localhost:8090/8000/3000/5173/4200
# TIANYAN_CORS_ORIGINS=https://example.com

# ========== 数据目录 ==========
# 默认 ~/.tianyan (数据库 + 上传)
# TIANYAN_DATA_DIR=~/.tianyan

# ========== 配置目录 ==========
# 默认 ~/.tianyan/config.yaml, 也可用项目根目录 config.yaml
# TIANYAN_CONFIG=config.yaml

# ========== 沙箱 ==========
SANDBOX_ENABLED=true      # 启用代码沙箱
SANDBOX_TIMEOUT=30        # 超时秒数

# ========== 代理 (访问海外模型时用) ==========
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
